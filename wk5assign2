#Assignment 2

class Vehicle:
    def move(self):
        return "Moving in some way..."

class Car(Vehicle):
    def move(self):
        return "Driving 🚗"

class Plane(Vehicle):
    def move(self):
        return "Flying ✈️"

class Boat(Vehicle):
    def move(self):
        return "Sailing 🚢"

# Creating objects
vehicles = [Car(), Plane(), Boat()]

for v in vehicles:
    print(v.move())

